+func TestIsDataNotFoundNewCodes(t *testing.T) {
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{name: "old code", err: Error{Code: ReceiptFiscalDataNotFound}, want: true},
+		{name: "new code", err: Error{Code: ReceiptFiscalDataNotFoundV2}, want: true},
+		{name: "invalid KKT", err: Error{Code: ReceiptFiscalDataInvalidKKT}, want: false},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := IsDataNotFound(tt.err); got != tt.want {
+				t.Errorf("IsDataNotFound() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestIsInvalidKKT(t *testing.T) {
+	if !IsInvalidKKT(Error{Code: ReceiptFiscalDataInvalidKKT}) {
+		t.Fatal("IsInvalidKKT() = false for invalid KKT error")
+	}
+	if IsInvalidKKT(Error{Code: ReceiptFiscalDataNotFoundV2}) {
+		t.Fatal("IsInvalidKKT() = true for not found error")
+	}
+}
